
<%
panel_title_id = "#{id}-title"
attributes = {
    id: "#{id}-panel",
    class: "lesli-panel relative z-50",
    "x-data": "{ open: false, trigger: null, openPanel() { this.trigger = document.activeElement; this.open = true; this.$nextTick(() => this.$refs.closeButton.focus()) }, closePanel() { this.open = false; this.$nextTick(() => this.trigger?.focus()) } }",
    "x-cloak": true,
    "@#{id}.window": "openPanel()",
    "@keydown.escape.window": "if (open) closePanel()"
}
%>

<%= content_tag(:section, **attributes) do %>
    <% if overlay %>
        <div
            class="fixed inset-0 z-40 bg-slate-950/25"
            aria-hidden="true"
            x-show="open"
            x-transition.opacity
            @click="closePanel()">
        </div>
    <% end %>

    <div
        class="fixed inset-y-0 right-0 z-50 flex h-dvh max-h-dvh w-full flex-col overflow-y-auto overscroll-contain bg-white shadow-2xl sm:max-w-2xl lg:max-w-3xl"
        role="dialog"
        aria-modal="<%= overlay %>"
        aria-labelledby="<%= panel_title_id %>"
        x-show="open"
        x-transition:enter="transform transition ease-out duration-150"
        x-transition:enter-start="translate-x-8 opacity-0"
        x-transition:enter-end="translate-x-0 opacity-100"
        x-transition:leave="transform transition ease-in duration-100"
        x-transition:leave-start="translate-x-0 opacity-100"
        x-transition:leave-end="translate-x-8 opacity-0">
        <div class="lesli-panel-header sticky top-0 z-10 flex items-center justify-between gap-4 border-b border-slate-200 bg-white">
            <h2 id="<%= panel_title_id %>" class="min-w-0 truncate text-lg font-semibold text-slate-900">
                <%= title %>
            </h2>
            <button
                type="button"
                class="inline-flex size-11 shrink-0 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sky-500/20"
                aria-label="Close panel"
                x-ref="closeButton"
                @click="closePanel()">
                <span class="material-symbols text-xl leading-none" aria-hidden="true">arrow_forward_ios</span>
            </button>
        </div>

        <div class="lesli-panel-body min-w-0 flex-1">
            <%= content %>
        </div>
    </div>
<% end %>
