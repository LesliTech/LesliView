%>

<li
    id="<%= dom_id(@resource, @scope_key) %>"
    class="lesli-items-tasks-item rounded-xl border transition-colors <%= @resource.done ? "lesli-items-tasks-task-done border-slate-200 bg-slate-50 hover:border-slate-300 hover:bg-slate-100" : "border-slate-200 hover:border-slate-300 hover:bg-slate-50" %>">
    <%= form_with(
            url: helpers.polymorphic_path(@resource),
            method: :patch,
            scope: @scope_key,
            local: true
        ) do |form| %>
        <%= form.hidden_field :id, value: @resource.id %>
        <%= form.button(
            type: "submit",
            aria: {
                label: toggle_label,
                pressed: @resource.done?
            },
            class: "flex w-full cursor-pointer items-center rounded-xl px-4 py-3 text-left text-sm font-medium text-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--lesli-color-primary)]"
        ) do %>
            <span class="flex min-w-0 items-center gap-3">
                <span
                    class="material-symbols-outlined shrink-0 text-xl leading-none <%= @resource.done ? "text-slate-400" : "text-[var(--lesli-color-primary)]" %>"
                    aria-hidden="true">
                    <%= @resource.done ? "check_box" : "check_box_outline_blank" %>
                </span>
                <% if @resource.done? %>
                    <del class="min-w-0 break-words text-slate-500 line-through">
                        <%= @resource.title %>
                    </del>
                <% else %>
                    <span class="min-w-0 break-words">
                        <%= @resource.title %>
                    </span>
                <% end %>
            </span>
        <% end %>
    <% end %>
</li>
