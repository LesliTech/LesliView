<div class="lesli-timelines py-6">
    <% if activities.any? %>
        <ul class="m-0 w-full list-none p-0">
            <% activities.each do |activity| %>
                <li class="group grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-4 md:grid-cols-[minmax(8rem,auto)_1.5rem_minmax(0,1fr)] md:gap-x-6">
                    <div class="col-start-2 mb-2 min-w-0 text-xs font-bold uppercase tracking-[0.2em] text-slate-500 md:col-start-1 md:row-start-1 md:mb-0 md:pt-1 md:text-right">
                        <time><%= activity["date"] %></time>

                        <% if activity["actor"].present? %>
                            <span class="mt-1 block font-normal normal-case tracking-normal text-slate-400">
                                <%= activity["actor"] %>
                            </span>
                        <% end %>
                    </div>

                    <div class="relative col-start-1 row-span-2 row-start-1 flex justify-center md:col-start-2">
                        <span
                            class="material-symbols-outlined relative z-10 bg-white text-xl leading-none text-[var(--lesli-color-primary)]"
                            aria-hidden="true">
                            <%= icon_for(activity) %>
                        </span>
                        <span class="absolute top-7 bottom-0 left-1/2 w-px -translate-x-1/2 bg-slate-300 group-last:hidden" aria-hidden="true"></span>
                    </div>

                    <div class="col-start-2 row-start-2 min-w-0 pb-10 md:col-start-3 md:row-start-1">
                        <h6 class="text-base font-semibold text-slate-800">
                            <%= activity["operation"] %>
                        </h6>

                        <% if activity["description"].present? %>
                            <p class="mt-1 text-sm leading-6 text-slate-600">
                                <%= activity["description"] %>
                            </p>
                        <% end %>
                    </div>
                </li>
            <% end %>
        </ul>
    <% else %>
        <%= render LesliView::Elements::Empty.new(text: empty_text) %>
    <% end %>
</div>
