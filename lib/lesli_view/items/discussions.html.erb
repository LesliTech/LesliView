%>
<article
    class="lesli-items-discussions bg-white p-4 sm:p-8"
    id="<%= dom_id(resource, :discussions) %>">
    <div class="lesli-items-discussions-form p-4">
        <%= form_with(
            scope: scope_key,
            model: comment,
            builder: LesliView::Forms::Builder,
            url: create_path
        ) do |form| %>
            <%= form.field_control_textarea(:message, rows: 4) %>
            <% if comment.errors[:message].any? %>
                <p class="mt-2 text-sm text-red-600">
                    <%= comment.errors.full_messages_for(:message).to_sentence %>
                </p>
            <% end %>
            <%= form.field_control_submit I18n.t(
                "lesli.items.discussions.add",
                default: "Add comment"
            ) %>
        <% end %>
    </div>
    <hr class="my-6 border-0 border-t border-slate-200">

    <div class="lesli-items-discussions-container p-4">
        <% if discussions.any? %>
            <ul
                id="<%= "#{scope_key}-lesli-items-discussions-list" %>"
                class="m-0 list-none space-y-6 p-0">
                <% discussions.each do |item| %>
                    <%= render(LesliView::Items::Discussion.new(item)) %>
                <% end %>
            </ul>
        <% else %>
            <p class="py-6 text-center text-sm text-slate-500">
                <%= I18n.t(
                    "lesli.items.discussions.empty",
                    default: "No comments have been added yet."
                ) %>
            </p>
        <% end %>
    </div>
</article>
