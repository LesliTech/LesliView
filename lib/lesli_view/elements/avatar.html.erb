<figure class="lesli-element-avatar <%= avatar_size %> flex shrink-0 items-center justify-center overflow-hidden rounded-full border-[0.1px] border-slate-400 bg-slate-100">
    <% if image %>
        <img class="h-full w-full object-cover" src="<%= image %>" alt="Avatar image">
    <% else %>
        <span class="font-bold text-slate-700 <%= font_size %>"><%= letter %></span>
    <% end %>
</figure>
