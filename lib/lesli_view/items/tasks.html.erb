%>
<article
    class="lesli-items-tasks rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
    id="<%= dom_id(@resource, :tasks) %>">
    <div class="lesli-items-tasks-form">
        <%= form_with(
            scope: scope_key,
            model: task,
            builder: LesliView::Forms::Builder,
            url: create_path
        ) do |form| %>
            <%= form.field_control_text :title %>
            <% if task.errors[:title].any? %>
                <p class="mt-2 text-sm text-red-600">
                    <%= task.errors.full_messages_for(:title).to_sentence %>
                </p>
            <% end %>
            <%= form.field_control_submit I18n.t(
                "lesli.items.tasks.add",
                default: "Add task"
            ) %>
        <% end %>
    </div>
    <hr class="my-6 border-0 border-t border-slate-200">

    <div class="lesli-items-tasks-container">
        <% if tasks.any? %>
            <ul
                id="<%= "#{scope_key}-lesli-items-tasks-list" %>"
                class="m-0 list-none space-y-3 p-0">
                <% tasks.each do |item| %>
                    <%= render(LesliView::Items::Task.new(item, scope_key)) %>
                <% end %>
            </ul>
        <% else %>
            <p class="py-6 text-center text-sm text-slate-500">
                <%= I18n.t(
                    "lesli.items.tasks.empty",
                    default: "No tasks have been added yet."
                ) %>
            </p>
        <% end %>
    </div>
</article>
