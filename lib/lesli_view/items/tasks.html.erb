%>
<article
    class="lesli-items-tasks rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
    id="<%= dom_id(@resource, :tasks) %>">
    <div class="lesli-items-tasks-form">
        <%= form_with(
            scope: scope_key,
            model: task_class.new,
            builder: LesliView::Forms::Builder,
            url: helpers.polymorphic_path([:items, :tasks], 
                taskable_type:@resource.class.name, 
                taskable_id: @resource.id
            )) do |form| %>
            <%= form.field_control_text :title %>
            <%= form.field_control_submit I18n.t("lesli.items.tasks.add") %>
        <% end %>
    </div>
    <hr class="my-6 border-0 border-t border-slate-200">

    <div class="lesli-items-tasks-container">
        <ul
            id="<%= "#{scope_key}-lesli-items-tasks-list" %>"
            class="m-0 list-none space-y-3 p-0">
            <% tasks.each do |task| %>
                <%= render(LesliView::Items::Task.new(task, scope_key)) %>
            <% end %>
        </ul>
    </div>
</article>
