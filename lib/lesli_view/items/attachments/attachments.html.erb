%>
<article
    class="lesli-items-attachments"
    id="<%= dom_id(resource, :attachments) %>">
    <%= form_with(
        scope: scope_key,
        model: attachment,
        builder: LesliView::Forms::Builder,
        url: create_path,
        multipart: true
    ) do |form| %>
        <div class="lesli-items-attachments-form">
            <div>
                <%= form.label(
                    :file,
                    I18n.t("lesli.items.attachments_choose_file", default: "Choose a file"),
                    class: "lesli-items-attachments-label"
                ) %>
                <%= form.file_field(
                    :file,
                    required: true,
                    accept: accepted_content_types,
                    class: "lesli-items-attachments-input"
                ) %>
                <% if attachment.errors[:file].any? %>
                    <p class="lesli-items-attachments-error">
                        <%= attachment.errors[:file].to_sentence %>
                    </p>
                <% end %>
            </div>

            <%= form.field_control_text(
                :label,
                label: I18n.t("lesli.items.attachments_label", default: "Label"),
                maxlength: 255
            ) %>

            <%= form.field_control_button(
                I18n.t("lesli.items.attachments_add", default: "Add file"),
                {
                    data: {
                        turbo_submits_with: I18n.t(
                            "lesli.items.attachments_uploading",
                            default: "Uploading..."
                        )
                    }
                },
                icon: "upload_file"
            ) %>
        </div>
    <% end %>

    <hr class="lesli-items-attachments-divider">

    <% if attachments.any? %>
        <ul class="lesli-items-attachments-list">
            <% attachments.each do |item| %>
                <%= render LesliView::Items::Attachment.new(
                    item,
                    path: attachment_path(item)
                ) %>
            <% end %>
        </ul>
    <% else %>
        <p class="lesli-items-attachments-empty">
            <%= I18n.t(
                "lesli.items.attachments_empty",
                default: "No files have been attached yet."
            ) %>
        </p>
    <% end %>
</article>

