
<section
    class="mx-auto mt-16 mb-12 grid w-full grid-cols-[minmax(0,1fr)_auto] items-start gap-5"
    <% if title.present? %>aria-labelledby="<%= title_id %>"<% end %>>

    <div class="min-w-0">
        <div class="flex items-center gap-4">

            <% if back? %>
                <%= link_to(
                    back_path,
                    class: "inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl border border-sky-600 bg-white text-sky-700 shadow-sm transition hover:bg-sky-50 hover:text-sky-800 focus:outline-none focus:ring-2 focus:ring-sky-500/30",
                    aria: { label: I18n.t("actions.back", default: "Go back") },
                    data: { turbo_frame: "_top" }
                ) do %>
                    <span class="material-symbols text-[26px] leading-none" aria-hidden="true">arrow_back</span>
                <% end %>
            <% end %>

            <div class="min-w-0">
                <% if title.present? %>
                    <h1 id="<%= title_id %>" class="lesli-header-title tracking-tight text-slate-700">
                        <%= title %>
                    </h1>
                <% end %>

                <% if subtitle.present? %>
                    <p class="lesli-header-subtitle mt-2 max-w-2xl text-slate-500">
                        <%= subtitle %>
                    </p>
                <% end %>
            </div>

        </div>
    </div>

    <% if actions? %>
        <div
            class="flex flex-wrap items-start justify-self-end gap-3"
            role="group"
            aria-label="<%= I18n.t('actions.label', default: 'Page actions') %>">
            <% if new_path.present? %>
                <%= render ::LesliView::Elements::Button.new(
                    new_button_label,
                    url: new_path,
                    icon: "add",
                    solid: true
                ) %>
            <% end %>

            <%= content if content? %>
        </div>
    <% end %>
</section>
